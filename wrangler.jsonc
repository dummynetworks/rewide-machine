{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rewide-machine",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-13",
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rewide-machine-db",
      "database_id": "323d7bb9-e7a7-439e-944e-cf0f7b27f8cb",
      "migrations_dir": "migrations"
    }
  ]
}
